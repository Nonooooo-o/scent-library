{
  "name": "personal-perfume-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.spa.config.mjs",
    "build": "node scripts/validate-world-cutouts.mjs && vite build --config vite.spa.config.mjs && node scripts/prune-deploy-assets.mjs",
    "start": "vite preview --config vite.spa.config.mjs",
    "thumbnails": "bash scripts/generate-thumbnails.sh",
    "research:enrich": "python3 scripts/enrich-archive.py",
    "validate:data": "node scripts/validate-library.mjs",
    "test:behavior": "node scripts/validate-library.mjs",
    "test:details": "node scripts/validate-library.mjs",
    "test:smoke": "node scripts/validate-build.mjs",
    "test:world": "node scripts/validate-world.mjs",
    "validate:world-cutouts": "node scripts/validate-world-cutouts.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-server-dom-webpack": "19.2.7",
    "vinext": "1.0.0-beta.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.1",
    "@vitejs/plugin-rsc": "0.5.27",
    "vite": "8.1.4"
  }
}
